[Unit]
Description=KOY Next.js frontend
After=network-online.target koy-backend.service
Wants=network-online.target

[Service]
Type=simple
User=koy
Group=koy
WorkingDirectory=/opt/koy/app/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/koy/app/frontend/.next

[Install]
WantedBy=multi-user.target
